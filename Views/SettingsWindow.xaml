<Window x:Class="WinCal.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCal 设置"
        Width="460" Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource HoverBrush}">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⚙ 设置"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1" x:Name="CloseButton"
                        Width="32" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="OnCloseClick">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Stretch="Uniform" Width="14" Height="14" />
                </Button>
            </Grid>
        </Border>

        <!-- 设置内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,16">

                <!-- ============ #1 颜色主题 ============ -->
                <TextBlock Text="颜色主题" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <ComboBox x:Name="ThemeComboBox" Margin="0,0,0,20" Padding="8,6"
                          SelectedIndex="0">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="深色" />
                </ComboBox>

                <!-- ============ #2 字体大小 ============ -->
                <TextBlock Text="字体大小" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="A" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider Grid.Column="1" x:Name="FontSizeSlider"
                            Minimum="-2" Maximum="2" Value="0"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="A" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="FontSizeLabel" Text="标准"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,16" />

                <!-- ============ #3 顶部时间日期（实现死设置 ShowHeaderDateTime / TimeFormat） ============ -->
                <TextBlock Text="顶部时间日期" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="显示时间"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="ShowHeaderDateTimeCheck"
                              VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="时间格式"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1" x:Name="TimeFormatCombo" Padding="8,6"
                              SelectedIndex="0" HorizontalAlignment="Left" MinWidth="140">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="12 小时制" />
                        <ComboBoxItem Content="24 小时制" />
                    </ComboBox>
                </Grid>

                <!-- ============ #4 开机自启动 ============ -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="开机自启动"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="AutoStartupCheckBox"
                              VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="AutoStartupAskedText" Text=""
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,20" TextWrapping="Wrap" />

                <!-- ============ #5 显示托盘图标（P0-2，默认关闭） ============ -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="显示托盘图标"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="ShowTrayIconCheck"
                              VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="关闭后托盘图标隐藏（可用快捷键或点时钟唤起面板；退出入口在本窗口内）。"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,20" TextWrapping="Wrap" />

                <!-- ============ #6 弹出快捷键（显示真实生效组合） ============ -->
                <TextBlock Text="弹出快捷键" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="当前生效"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border Grid.Column="1" Background="{DynamicResource HoverBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,6"
                            HorizontalAlignment="Left" MinWidth="160">
                        <TextBlock x:Name="HotkeyValueText" Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                </Grid>
                <TextBlock Text="期望组合（下次启动生效）"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,4" />
                <TextBox x:Name="HotkeyInputBox" Padding="8,6" Margin="0,0,0,4"
                         ToolTip="例如 Ctrl+Alt+C；必须至少含一个修饰键（Ctrl/Alt/Shift/Win）" />
                <TextBlock Text="若期望组合被其它程序占用，启动时会自动尝试备选组合，上方显示实际生效值。"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,20" TextWrapping="Wrap" />

                <!-- ============ #7 启用日程功能（P0-7，默认关闭） ============ -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="启用日程功能"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="EnableScheduleCheck"
                              VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="默认关闭；关闭时休班 / 节气标记照常显示，仅隐藏日程层。"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8" TextWrapping="Wrap" />

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="日程区默认展开"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="ScheduleExpandedCheck"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- ============ #8 日历数据源（「系统日历」诚实标注不可用） ============ -->
                <TextBlock Text="日历数据源" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <ComboBox x:Name="DataSourceComboBox" Margin="0,0,0,6" Padding="8,6"
                          SelectedIndex="1" SelectionChanged="OnDataSourceChanged">
                    <ComboBoxItem x:Name="SystemCalendarItem" Content="系统日历" />
                    <ComboBoxItem Content="ICS 订阅链接" />
                    <ComboBoxItem Content="两者都用" />
                </ComboBox>
                <TextBlock x:Name="SystemCalendarNote"
                           FontSize="11"
                           Foreground="{DynamicResource HolidayTextBrush}"
                           Margin="0,0,0,12" TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- ICS 订阅列表（含「用途」下拉 + 启停勾选） -->
                <StackPanel x:Name="IcsPanel" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="ICS 订阅（每条可指定用途）"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />

                    <ItemsControl x:Name="SubscriptionList" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                        CornerRadius="6"
                                        Padding="8,6"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                                     Fill="{Binding Color}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayUrl}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="6,0,6,0"
                                                      ToolTip="启用该订阅" />
                                            <ComboBox Grid.Column="3"
                                                      SelectedIndex="{Binding PurposeIndex, Mode=TwoWay}"
                                                      Width="118" Padding="6,3"
                                                      Margin="0,0,6,0"
                                                      ToolTip="用途：决定数据进入哪条数据流">
                                                <ComboBoxItem Content="节假日" />
                                                <ComboBoxItem Content="农历节气" />
                                                <ComboBoxItem Content="日程" />
                                            </ComboBox>
                                            <Button Grid.Column="4" Content="✕"
                                                    FontSize="11" Width="24" Height="24"
                                                    Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="OnRemoveSubscription"
                                                    Tag="{Binding}" />
                                        </Grid>
                                        <TextBox Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Padding="4,3" Margin="14,4,0,0"
                                                 ToolTip="为此订阅设置一个显示名称" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 添加新订阅 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="NewIcsUrlTextBox"
                                 Padding="8,6"
                                 ToolTip="输入 .ics 日历订阅链接" />
                        <Button Grid.Column="1" Content="添加"
                                Padding="12,6" Margin="6,0,0,0"
                                Background="{DynamicResource TodayAccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="OnAddSubscription" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="刷新频率"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="IcsRefreshCombo"
                                  Margin="8,0,0,0" Padding="6,4"
                                  SelectedIndex="1" HorizontalAlignment="Left">
                            <ComboBoxItem Content="10 分钟" />
                            <ComboBoxItem Content="30 分钟" />
                            <ComboBoxItem Content="60 分钟" />
                            <ComboBoxItem Content="120 分钟" />
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <!-- ============ #9 近期事件显示范围 ============ -->
                <TextBlock Text="近期事件显示范围" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <ComboBox x:Name="UpcomingDaysCombo" Margin="0,0,0,20" Padding="8,6"
                          SelectedIndex="1">
                    <ComboBoxItem Content="1 天" />
                    <ComboBoxItem Content="3 天" />
                    <ComboBoxItem Content="7 天" />
                </ComboBox>

                <!-- ============ #10 周起始日 ============ -->
                <TextBlock Text="周起始日" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton x:Name="WeekStartSunday" Content="周日" Margin="0,0,20,0"
                                 VerticalAlignment="Center" />
                    <RadioButton x:Name="WeekStartMonday" Content="周一"
                                 VerticalAlignment="Center" />
                </StackPanel>

                <!-- ============ #11 使用模拟数据（P0-8，仅开发调试，默认关闭） ============ -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="使用模拟数据（仅开发调试）"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="UseMockDataCheck"
                              VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="⚠ 默认关闭。开启后日程层将使用模拟假数据（非真实日程），仅供调试，请勿在正式使用中开启。"
                           FontSize="11" Foreground="{DynamicResource HolidayTextBrush}"
                           Margin="0,0,0,20" TextWrapping="Wrap" />

                <!-- ============ #12 首次运行状态（只读，供 T05 首启引导） ============ -->
                <TextBlock Text="首次运行状态" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock x:Name="FirstRunStateText" Text=""
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4" TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SeparatorBrush}"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="FooterLink"
                           Text="WinCal v1.0 By www.huangao.net"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           MouseDown="OnFooterLinkClick" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="恢复默认"
                            Padding="12,6" Margin="0,0,8,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource SeparatorBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnResetDefaults" />
                    <Button Content="退出程序"
                            Padding="12,6" Margin="0,0,8,0"
                            Background="Transparent"
                            BorderBrush="#FFC62828"
                            Foreground="#FFC62828"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnExitApp" />
                    <Button Content="保存"
                            Padding="20,6"
                            Background="{DynamicResource TodayAccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>

<Window x:Class="WinCal.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinCal.Views.Controls"
        Title="WinCal"
        Width="420" Height="620"
        MinWidth="320" MinHeight="576"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- 布尔 → 可见性转换器（本窗口自备，避免改动 App.xaml —— 它归属 T05） -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 年月选择浮层内的按钮：透明底、圆角、hover 用 HoverBrush -->
        <Style x:Key="PickerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PickerBg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickerBg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 圆角外框：圆角与裁剪由 Border 提供（不使用 WindowChrome）；右下角锚点固定由 PanelResizeHelper 保证 -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- 0 诚实横幅（可折叠） -->
                <RowDefinition Height="44" />    <!-- 1 Header -->
                <RowDefinition Height="*" />     <!-- 2 月历（星期头 24 + 6×7 网格） -->
                <RowDefinition Height="Auto" />  <!-- 3 放假速览条（可折叠） -->
                <RowDefinition Height="Auto" />  <!-- 4 黄历详情面板（点哪天显示哪天） -->
                <RowDefinition Height="Auto" />  <!-- 5 日程三态区（启用日程时显示在黄历下方） -->
            </Grid.RowDefinitions>

            <!-- ============ 诚实横幅（P0-8，默认折叠） ============ -->
            <Border Grid.Row="0"
                    x:Name="BannerBar"
                    Background="{DynamicResource WorkdayBrush}"
                    CornerRadius="6"
                    Margin="8,8,8,0"
                    Padding="8,4"
                    Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding BannerText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            x:Name="BannerCloseButton"
                            Content="✕"
                            Width="18" Height="18"
                            FontSize="10"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnBannerCloseClick"
                            Margin="6,0,0,0" />
                </Grid>
            </Border>

            <!-- ============ Header（H=44，年月 + 农历 + 时间 + 今天 + 图钉 + 齿轮） ============ -->
            <Grid Grid.Row="1" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 上一月 -->
                <Button Grid.Column="0"
                        x:Name="PrevButton"
                        Content="‹"
                        FontSize="20" FontWeight="Bold"
                        Width="28" Height="28"
                        Background="Transparent"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="OnPrevMonthClick" />

                <!-- 年月（FontSize 16 / SemiBold）+ 农历年月日；点年月标题弹出年月选择浮层 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0">
                    <Button x:Name="MonthTitleButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="3,2"
                            Cursor="Hand"
                            Focusable="False"
                            ToolTip="点击选择年月"
                            Click="OnMonthTitleClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="MonthTitle"
                                       Text="{Binding MonthDisplay}"
                                       FontSize="{DynamicResource HeaderMonthFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="▾"
                                       FontSize="9"
                                       Margin="3,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="LunarHeaderText"
                               Text="{Binding YearSecondaryText}"
                               FontSize="{DynamicResource HeaderSecondaryFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>

                <!-- 下一月 -->
                <Button Grid.Column="2"
                        x:Name="NextButton"
                        Content="›"
                        FontSize="20" FontWeight="Bold"
                        Width="28" Height="28"
                        Background="Transparent"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="OnNextMonthClick" />

                <!-- Header 时间（受 ShowHeaderDateTime / TimeFormat 控制） -->
                <TextBlock Grid.Column="4"
                           x:Name="HeaderTimeText"
                           Text="{Binding HeaderTimeText}"
                           FontSize="{DynamicResource HeaderSecondaryFontSize}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Visibility="{Binding IsHeaderTimeVisible, Converter={StaticResource BoolToVisibility}}" />

                <!-- 今天（高 24 / 圆角 12 / 强调色底；用显式模板保证圆角可靠生效） -->
                <Button Grid.Column="5"
                        x:Name="TodayButton"
                        Content="今天"
                        FontSize="11" FontWeight="SemiBold"
                        Height="24"
                        Margin="0,0,6,0"
                        Foreground="{DynamicResource TextOnAccentBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="OnTodayClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TodayBorder"
                                    Background="{DynamicResource TodayAccentBrush}"
                                    CornerRadius="12"
                                    Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 图钉按钮（24×24，图标 14×14）：固定/取消固定面板 -->
                <Button Grid.Column="6"
                        x:Name="PinButton"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="固定到屏幕（点击别处不关闭）"
                        Click="OnPinClick">
                    <Grid>
                        <!-- 未固定：次级色 -->
                        <Path x:Name="PinIcon"
                              Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Stretch="Uniform" Width="14" Height="14" />
                        <!-- 已固定：强调色 -->
                        <Path x:Name="PinIconActive"
                              Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
                              Fill="{DynamicResource TodayAccentBrush}"
                              Stretch="Uniform" Width="14" Height="14"
                              Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- 齿轮按钮（24×24，图标 14×14） -->
                <Button Grid.Column="7"
                        x:Name="SettingsButton"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="设置"
                        Click="OnSettingsClick">
                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,13L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Stretch="Uniform"
                          Width="14" Height="14" />
                </Button>
            </Grid>

            <!-- ============ 月历（星期头 24 + 网格 *） ============ -->
            <local:MonthCalendar Grid.Row="2"
                                 x:Name="Calendar"
                                 MinHeight="316" />

            <!-- ============ 放假速览条（P1-1，无假期时折叠不占高度） ============ -->
            <local:HolidaySummaryBar Grid.Row="3"
                                     DataContext="{Binding}"
                                     Visibility="{Binding HasHolidaySummary, Converter={StaticResource BoolToVisibility}}" />

            <!-- ============ 黄历详情面板（点哪天显示哪天；无黄历源时整块隐藏，高度还给网格） ============ -->
            <local:AlmanacDetailPanel Grid.Row="4"
                                      x:Name="AlmanacPanel"
                                      TitleText="{Binding SelectedAlmanacTitle}"
                                      Almanac="{Binding SelectedDayAlmanac}"
                                      Visibility="{Binding HasAlmanacSource, Converter={StaticResource BoolToVisibility}}" />

            <!-- ============ 日程三态区（P0-7） ============ -->
            <Grid Grid.Row="5" Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- 折叠栏 28px -->
                    <RowDefinition Height="Auto" />  <!-- 事件列表 176px（展开态） -->
                </Grid.RowDefinitions>

                <!-- 折叠栏（H=28） -->
                <Border Grid.Row="0" x:Name="ScheduleToggleBar" Height="28" Cursor="Hand" MouseLeftButtonUp="OnToggleSchedule">
                    <TextBlock x:Name="ScheduleToggleText"
                               Text="{Binding ScheduleToggleText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0" />
                </Border>

                <!-- 事件列表（H=176，展开态显示） -->
                <ScrollViewer Grid.Row="1"
                              x:Name="EventScrollViewer"
                              Height="176"
                              VerticalScrollBarVisibility="Auto"
                              Padding="4,0,4,12"
                              Visibility="{Binding IsScheduleListVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ItemsControl x:Name="EventListControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:EventItem EventData="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EndMarker"
                                   Text="- End -"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,2"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="NoEventsText"
                                   Text="暂无近期事件"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,24,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 右下角缩放抓手（16×16，3×3 点阵） ============ -->
            <Canvas Grid.Row="0" Grid.RowSpan="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="16" Height="16"
                    IsHitTestVisible="False"
                    Margin="0,0,2,2">
                <Ellipse x:Name="GripDot00" Canvas.Left="4"  Canvas.Top="4"  Width="2" Height="2" Fill="{DynamicResource TextDisabledBrush}" />
                <Ellipse x:Name="GripDot01" Canvas.Left="8"  Canvas.Top="4"  Width="2" Height="2" Fill="{DynamicResource TextDisabledBrush}" />
                <Ellipse x:Name="GripDot02" Canvas.Left="12" Canvas.Top="4"  Width="2" Height="2" Fill="{DynamicResource TextDisabledBrush}" />
                <Ellipse x:Name="GripDot10" Canvas.Left="4"  Canvas.Top="8"  Width="2" Height="2" Fill="{DynamicResource TextDisabledBrush}" />
                <Ellipse x:Name="GripDot11" Canvas.Left="8"  Canvas.Top="8"  Width="2" Height="2" Fill="{DynamicResource TextDisabledBrush}" />
                <Ellipse x:Name="GripDot12" Canvas.Left="12" Canvas.Top="8"  Width="2" Height="2" Fill="{DynamicResource TextDisabledBrush}" />
                <Ellipse x:Name="GripDot20" Canvas.Left="4"  Canvas.Top="12" Width="2" Height="2" Fill="{DynamicResource TextDisabledBrush}" />
                <Ellipse x:Name="GripDot21" Canvas.Left="8"  Canvas.Top="12" Width="2" Height="2" Fill="{DynamicResource TextDisabledBrush}" />
                <Ellipse x:Name="GripDot22" Canvas.Left="12" Canvas.Top="12" Width="2" Height="2" Fill="{DynamicResource TextDisabledBrush}" />
            </Canvas>

            <!-- ============ 年月快速跳转浮层（默认隐藏；点 Header 年月标题弹出） ============ -->
            <Grid x:Name="PickerOverlay"
                  Grid.Row="0" Grid.RowSpan="6"
                  Background="#66000000"
                  Visibility="Collapsed"
                  MouseLeftButtonDown="OnPickerOverlayClick">
                <Border x:Name="PickerCard"
                        Width="292" Height="256"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid Margin="12,10,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 年份导航行：«(±10年) ‹(±1年) [年标签] ›(±1年) »(±10年) -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="PickerPrevDecadeButton" Style="{StaticResource PickerButtonStyle}"
                                    Content="«" FontSize="15" Width="28" Height="26" VerticalAlignment="Center"
                                    ToolTip="前 10 年" Click="OnPickerPrevDecadeClick" />
                            <Button Grid.Column="1" x:Name="PickerPrevYearButton" Style="{StaticResource PickerButtonStyle}"
                                    Content="‹" FontSize="17" Width="26" Height="26" VerticalAlignment="Center"
                                    ToolTip="前 1 年" Click="OnPickerPrevYearClick" />
                            <Button Grid.Column="2" x:Name="PickerYearLabelButton" Style="{StaticResource PickerButtonStyle}"
                                    Content="2026年" FontSize="13" FontWeight="SemiBold" Height="28" VerticalAlignment="Center"
                                    Click="OnPickerYearLabelClick" />
                            <Button Grid.Column="3" x:Name="PickerNextYearButton" Style="{StaticResource PickerButtonStyle}"
                                    Content="›" FontSize="17" Width="26" Height="26" VerticalAlignment="Center"
                                    ToolTip="后 1 年" Click="OnPickerNextYearClick" />
                            <Button Grid.Column="4" x:Name="PickerNextDecadeButton" Style="{StaticResource PickerButtonStyle}"
                                    Content="»" FontSize="15" Width="28" Height="26" VerticalAlignment="Center"
                                    ToolTip="后 10 年" Click="OnPickerNextDecadeClick" />
                        </Grid>

                        <!-- 内容网格（月份 3×4 / 年份 3×4，由代码生成） -->
                        <UniformGrid Grid.Row="1" x:Name="PickerGrid" Rows="4" Columns="3" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

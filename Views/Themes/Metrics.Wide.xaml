<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 宽松档（宽度 ≥ 480）：日期数字 20 / 次级 11 / 胶囊 高15 宽24 字号10 / 事件圆点显示 -->

    <!-- 日期数字字号 -->
    <sys:Double x:Key="CellDayFontSize">20</sys:Double>

    <!-- 次级文字字号（农历 / 节气 / 节日） -->
    <sys:Double x:Key="CellSecondaryFontSize">11</sys:Double>

    <!-- 格子内容层外边距（D-3：随档位缩放，避免硬编码绝对值） -->
    <Thickness x:Key="CellContentMargin">4,3,4,2</Thickness>

    <!-- 事件圆点行外边距（D-3：与内容层 Bottom 相加恒为 4，达成「圆点居底 Bottom=4」） -->
    <Thickness x:Key="EventDotsMargin">0,0,0,2</Thickness>

    <!-- 今日强调色圆底直径（D-3：随档位缩放） -->
    <sys:Double x:Key="TodayCircleSize">34</sys:Double>

    <!-- 休/班 胶囊 -->
    <sys:Double x:Key="CapsuleFontSize">10</sys:Double>
    <sys:Double x:Key="CapsuleOpacity">1</sys:Double>
    <sys:Double x:Key="CapsuleHeight">15</sys:Double>
    <sys:Double x:Key="CapsuleWidth">24</sys:Double>

    <!-- 格子内边距 / 圆角 -->
    <sys:Double x:Key="CellPadding">3</sys:Double>
    <CornerRadius x:Key="CellCornerRadius">6</CornerRadius>

    <!-- 事件圆点边长（0 = 隐藏） -->
    <sys:Double x:Key="CellEventDotSize">4</sys:Double>

    <!-- 星期头字号 -->
    <sys:Double x:Key="WeekHeaderFontSize">12</sys:Double>

    <!-- Header 年月字号 / 次级字号 -->
    <sys:Double x:Key="HeaderMonthFontSize">17</sys:Double>
    <sys:Double x:Key="HeaderSecondaryFontSize">13</sys:Double>

    <!-- 黄历详情面板 -->
    <sys:Double x:Key="AlmanacPanelHeight">182</sys:Double>
    <sys:Double x:Key="AlmanacTitleFontSize">15</sys:Double>
    <sys:Double x:Key="AlmanacBodyFontSize">13</sys:Double>
    <sys:Double x:Key="AlmanacMetaFontSize">12</sys:Double>

</ResourceDictionary>

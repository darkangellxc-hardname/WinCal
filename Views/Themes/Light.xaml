<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景色 -->
    <Color x:Key="BackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>

    <!-- 强调色 -->
    <Color x:Key="TodayAccentColor">#FF0078D4</Color>

    <!-- 文本色 -->
    <Color x:Key="TextPrimaryColor">#FF1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#FF767676</Color>
    <Color x:Key="TextDisabledColor">#FFB3B3B3</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <!-- 分隔与边框 -->
    <Color x:Key="SeparatorColor">#FFE5E5E5</Color>
    <Color x:Key="BorderColor">#FFD4D4D4</Color>

    <!-- 交互状态 -->
    <Color x:Key="HoverColor">#FFF3F3F3</Color>
    <Color x:Key="PressedColor">#FFE8E8E8</Color>
    <Color x:Key="SelectedColor">#FFE0EFFA</Color>

    <!-- 阴影 -->
    <Color x:Key="ShadowColor">#33000000</Color>

    <!-- 事件圆点 -->
    <Color x:Key="EventDotColor">#FF0078D4</Color>

    <!-- ★ T03 新增：休 / 班 / 节气 / 农历节日 / 胶囊 / 周末（架构 §8④ 精确色值） -->
    <Color x:Key="HolidayColor">#FFFDECEC</Color>          <!-- 休：整格浅红底（对齐参考图） -->
    <Color x:Key="WorkdayColor">#FFEAF2FA</Color>          <!-- 班：整格浅蓝灰底 -->
    <Color x:Key="HolidayTextColor">#FFD13438</Color>      <!-- 节日名 / 红 -->
    <Color x:Key="SolarTermTextColor">#FF107C10</Color>    <!-- 节气 / 绿 -->
    <Color x:Key="LunarFestivalTextColor">#FFC75B12</Color><!-- 农历节日 / 橙 -->
    <Color x:Key="CapsuleHolidayColor">#FFE8A33D</Color>   <!-- 休 胶囊底（白字） -->
    <Color x:Key="CapsuleWorkdayColor">#FF5B7C99</Color>   <!-- 班 胶囊底（白字） -->
    <Color x:Key="WeekendTextColor">#FF8A8A8A</Color>      <!-- 周末弱区分（P1-3） -->

    <!-- ★ T03 新增：黄历详情面板 -->
    <Color x:Key="AlmanacYiColor">#FF2E7D32</Color>        <!-- 宜 / 绿 -->
    <Color x:Key="AlmanacJiColor">#FFC62828</Color>        <!-- 忌 / 红 -->
    <Color x:Key="AlmanacJiShenColor">#FFA87900</Color>    <!-- 吉神 / 暗金 -->
    <Color x:Key="AlmanacXiongShaColor">#FF7A5C8A</Color>  <!-- 凶煞 / 灰紫 -->

    <!-- 画刷（从颜色派生） -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="TodayAccentBrush" Color="{StaticResource TodayAccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="EventDotBrush" Color="{StaticResource EventDotColor}" />

    <!-- ★ T03 新增画刷 -->
    <SolidColorBrush x:Key="HolidayBrush" Color="{StaticResource HolidayColor}" />
    <SolidColorBrush x:Key="WorkdayBrush" Color="{StaticResource WorkdayColor}" />
    <SolidColorBrush x:Key="HolidayTextBrush" Color="{StaticResource HolidayTextColor}" />
    <SolidColorBrush x:Key="SolarTermTextBrush" Color="{StaticResource SolarTermTextColor}" />
    <SolidColorBrush x:Key="LunarFestivalTextBrush" Color="{StaticResource LunarFestivalTextColor}" />
    <SolidColorBrush x:Key="CapsuleHolidayBrush" Color="{StaticResource CapsuleHolidayColor}" />
    <SolidColorBrush x:Key="CapsuleWorkdayBrush" Color="{StaticResource CapsuleWorkdayColor}" />
    <SolidColorBrush x:Key="WeekendTextBrush" Color="{StaticResource WeekendTextColor}" />

    <!-- ★ T03 新增画刷：黄历详情面板 -->
    <SolidColorBrush x:Key="AlmanacYiBrush" Color="{StaticResource AlmanacYiColor}" />
    <SolidColorBrush x:Key="AlmanacJiBrush" Color="{StaticResource AlmanacJiColor}" />
    <SolidColorBrush x:Key="AlmanacJiShenBrush" Color="{StaticResource AlmanacJiShenColor}" />
    <SolidColorBrush x:Key="AlmanacXiongShaBrush" Color="{StaticResource AlmanacXiongShaColor}" />

</ResourceDictionary>

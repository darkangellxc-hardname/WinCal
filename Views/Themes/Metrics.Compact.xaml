<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 紧凑档（宽度 < 380）：日期数字 15 / 次级 9 / 胶囊隐藏文字 / 事件圆点隐藏 -->

    <!-- 日期数字字号 -->
    <sys:Double x:Key="CellDayFontSize">15</sys:Double>

    <!-- 次级文字字号（农历 / 节气 / 节日） -->
    <sys:Double x:Key="CellSecondaryFontSize">9</sys:Double>

    <!-- 格子内容层外边距（D-3：随档位缩放，避免硬编码绝对值） -->
    <Thickness x:Key="CellContentMargin">2,2,2,1</Thickness>

    <!-- 事件圆点行外边距（D-3：与内容层 Bottom 相加恒为 4，达成「圆点居底 Bottom=4」） -->
    <Thickness x:Key="EventDotsMargin">0,0,0,3</Thickness>

    <!-- 今日强调色圆底直径（D-3：随档位缩放） -->
    <sys:Double x:Key="TodayCircleSize">26</sys:Double>

    <!-- 休/班 胶囊 -->
    <sys:Double x:Key="CapsuleFontSize">9</sys:Double>
    <sys:Double x:Key="CapsuleOpacity">0</sys:Double>
    <sys:Double x:Key="CapsuleHeight">14</sys:Double>
    <sys:Double x:Key="CapsuleWidth">22</sys:Double>

    <!-- 格子内边距 / 圆角 -->
    <sys:Double x:Key="CellPadding">2</sys:Double>
    <CornerRadius x:Key="CellCornerRadius">4</CornerRadius>

    <!-- 事件圆点边长（0 = 隐藏） -->
    <sys:Double x:Key="CellEventDotSize">0</sys:Double>

    <!-- 星期头字号 -->
    <sys:Double x:Key="WeekHeaderFontSize">10</sys:Double>

    <!-- Header 年月字号 / 次级字号 -->
    <sys:Double x:Key="HeaderMonthFontSize">14</sys:Double>
    <sys:Double x:Key="HeaderSecondaryFontSize">11</sys:Double>

    <!-- 黄历详情面板 -->
    <sys:Double x:Key="AlmanacPanelHeight">146</sys:Double>
    <sys:Double x:Key="AlmanacTitleFontSize">13</sys:Double>
    <sys:Double x:Key="AlmanacBodyFontSize">11</sys:Double>
    <sys:Double x:Key="AlmanacMetaFontSize">10</sys:Double>

</ResourceDictionary>

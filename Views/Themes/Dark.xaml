<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景色 -->
    <Color x:Key="BackgroundColor">#FF2D2D2D</Color>
    <Color x:Key="CardBackgroundColor">#FF383838</Color>

    <!-- ★ 输入控件 / 次级表面（2026-10-30 新增，供 Controls.xaml 使用） -->
    <Color x:Key="SurfaceAltColor">#FF333333</Color>        <!-- 设置分组卡片底 -->
    <Color x:Key="InputBackgroundColor">#FF262626</Color>    <!-- 输入框凹陷底 -->
    <Color x:Key="InputBorderColor">#FF454545</Color>
    <Color x:Key="InputBorderHoverColor">#FF5E5E5E</Color>
    <Color x:Key="AccentSoftColor">#FF1B3D52</Color>        <!-- 强调色低透明衬底 -->
    <Color x:Key="DangerColor">#FFEF6B6B</Color>

    <!-- 强调色 -->
    <Color x:Key="TodayAccentColor">#FF4CC2FF</Color>

    <!-- 文本色 -->
    <Color x:Key="TextPrimaryColor">#FFEDEDED</Color>
    <Color x:Key="TextSecondaryColor">#FFA8A8A8</Color>
    <Color x:Key="TextDisabledColor">#FF6E6E6E</Color>
    <Color x:Key="TextOnAccentColor">#FF101010</Color>

    <!-- 分隔与边框 -->
    <Color x:Key="SeparatorColor">#FF404040</Color>
    <Color x:Key="BorderColor">#FF4A4A4A</Color>

    <!-- 交互状态 -->
    <Color x:Key="HoverColor">#FF383838</Color>
    <Color x:Key="PressedColor">#FF454545</Color>
    <Color x:Key="SelectedColor">#FF1A3A4F</Color>

    <!-- 阴影 -->
    <Color x:Key="ShadowColor">#66000000</Color>

    <!-- 事件圆点 -->
    <Color x:Key="EventDotColor">#FF4CC2FF</Color>

    <!-- ★ T03 新增：休 / 班 / 节气 / 农历节日 / 胶囊 / 周末（架构 §8④ 精确色值） -->
    <Color x:Key="HolidayColor">#FF3A2426</Color>          <!-- 休：整格浅红底（对齐参考图） -->
    <Color x:Key="WorkdayColor">#FF22303C</Color>          <!-- 班：整格浅蓝灰底 -->
    <Color x:Key="HolidayTextColor">#FFFF99A4</Color>      <!-- 节日名 / 红 -->
    <Color x:Key="SolarTermTextColor">#FF6CCB5F</Color>    <!-- 节气 / 绿 -->
    <Color x:Key="LunarFestivalTextColor">#FFFFA94D</Color><!-- 农历节日 / 橙 -->
    <Color x:Key="CapsuleHolidayColor">#FFE8A33D</Color>   <!-- 休 胶囊底（白字） -->
    <Color x:Key="CapsuleWorkdayColor">#FF5B7C99</Color>   <!-- 班 胶囊底（白字） -->
    <Color x:Key="WeekendTextColor">#FF9A9A9A</Color>      <!-- 周末弱区分（P1-3） -->

    <!-- ★ T03 新增：黄历详情面板 -->
    <Color x:Key="AlmanacYiColor">#FF6CCB5F</Color>        <!-- 宜 / 绿 -->
    <Color x:Key="AlmanacJiColor">#FFFF99A4</Color>        <!-- 忌 / 红 -->
    <Color x:Key="AlmanacJiShenColor">#FFE0B34D</Color>    <!-- 吉神 / 暗金 -->
    <Color x:Key="AlmanacXiongShaColor">#FFB894CC</Color>  <!-- 凶煞 / 灰紫 -->

    <!-- 画刷（从颜色派生） -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="TodayAccentBrush" Color="{StaticResource TodayAccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="EventDotBrush" Color="{StaticResource EventDotColor}" />

    <!-- ★ 输入控件 / 次级表面画刷 -->
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="{StaticResource InputBorderHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <!-- ★ T03 新增画刷 -->
    <SolidColorBrush x:Key="HolidayBrush" Color="{StaticResource HolidayColor}" />
    <SolidColorBrush x:Key="WorkdayBrush" Color="{StaticResource WorkdayColor}" />
    <SolidColorBrush x:Key="HolidayTextBrush" Color="{StaticResource HolidayTextColor}" />
    <SolidColorBrush x:Key="SolarTermTextBrush" Color="{StaticResource SolarTermTextColor}" />
    <SolidColorBrush x:Key="LunarFestivalTextBrush" Color="{StaticResource LunarFestivalTextColor}" />
    <SolidColorBrush x:Key="CapsuleHolidayBrush" Color="{StaticResource CapsuleHolidayColor}" />
    <SolidColorBrush x:Key="CapsuleWorkdayBrush" Color="{StaticResource CapsuleWorkdayColor}" />
    <SolidColorBrush x:Key="WeekendTextBrush" Color="{StaticResource WeekendTextColor}" />

    <!-- ★ T03 新增画刷：黄历详情面板 -->
    <SolidColorBrush x:Key="AlmanacYiBrush" Color="{StaticResource AlmanacYiColor}" />
    <SolidColorBrush x:Key="AlmanacJiBrush" Color="{StaticResource AlmanacJiColor}" />
    <SolidColorBrush x:Key="AlmanacJiShenBrush" Color="{StaticResource AlmanacJiShenColor}" />
    <SolidColorBrush x:Key="AlmanacXiongShaBrush" Color="{StaticResource AlmanacXiongShaColor}" />

</ResourceDictionary>

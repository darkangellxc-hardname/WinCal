<UserControl x:Class="WinCal.Views.Controls.MonthCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinCal.Views.Controls">

    <!-- 月历控件：星期头（24px）+ 6×7 网格（导航已上移到面板 Header，见 PRD §6.1） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 星期头（动态更新，支持周一起始 / 周日起始） -->
        <Grid Grid.Row="0" x:Name="WeekHeaderGrid" Height="24" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="H0" FontSize="{DynamicResource WeekHeaderFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="H1" FontSize="{DynamicResource WeekHeaderFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" x:Name="H2" FontSize="{DynamicResource WeekHeaderFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" x:Name="H3" FontSize="{DynamicResource WeekHeaderFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" x:Name="H4" FontSize="{DynamicResource WeekHeaderFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" x:Name="H5" FontSize="{DynamicResource WeekHeaderFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="6" x:Name="H6" FontSize="{DynamicResource WeekHeaderFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- 日历网格（6 行 × 7 列） -->
        <ItemsControl Grid.Row="1" x:Name="CalendarGrid" Margin="8,0,8,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:DayCell DayData="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
